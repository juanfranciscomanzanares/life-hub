# Copia este archivo como ".env" y rellena con tus datos de Supabase.
# Los encuentras en Supabase > Project Settings > API.
# Si dejas estas variables vacías, la app funciona igual pero guardando
# los datos solo en el navegador (sin sincronización en la nube).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# (Opcional) URL base de tus Edge Functions, para precios de acciones/ETF.
# Ej: https://TU-PROYECTO.functions.supabase.co
VITE_FUNCTIONS_URL=
